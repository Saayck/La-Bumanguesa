{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd angular && npx pnpm@latest install",
  "buildCommand": "cd angular && npx pnpm@latest run build",
  "outputDirectory": "angular/dist/labumanguesa/browser",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
