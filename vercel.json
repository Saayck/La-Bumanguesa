{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd angular && pnpm install && pnpm run build",
  "outputDirectory": "angular/dist/labumanguesa/browser",
  "installCommand": "cd angular && pnpm install",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
