# =====================================================================
# La Bumanguesa — Variables de entorno (Plantilla de ejemplo)
# Copia este archivo a `.env` y configura tus valores reales.
# NUNCA subas el archivo `.env` a Git.
# =====================================================================

# Servidor API
SERVER_PORT=8080

# Base de Datos PostgreSQL
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://db:5432/labumanguesa?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_NAME=labumanguesa
DB_USER=postgres
DB_PASSWORD=tu_contrasena_db_aqui

# Seguridad / JWT
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_64_caracteres_aqui
JWT_EXPIRATION_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_admin_seguro_aqui

# CORS / URLs de Origen
CORS_ORIGINS=http://localhost:4200
