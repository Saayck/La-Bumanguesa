# =====================================================================
# La Bumanguesa — Variables de entorno (Plantilla de ejemplo)
# Copia este archivo a `.env` y configura tus valores reales.
# NUNCA subas el archivo `.env` a Git.
# =====================================================================

# Servidor API
SERVER_PORT=8080

# Base de Datos PostgreSQL
DB_DRIVER=org.postgresql.Driver
DB_URL=jdbc:postgresql://db:5432/labumanguesa?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_NAME=labumanguesa
DB_USER=postgres
DB_PASSWORD=tu_contrasena_db_aqui

# Seguridad / JWT
JWT_SECRET=tu_clave_secreta_jwt_de_al_menos_64_caracteres_aqui
JWT_EXPIRATION_MS=86400000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tu_password_admin_seguro_aqui

# CORS / URLs de Origen
CORS_ORIGINS=http://localhost:4200

# =====================================================================
# IA — modelos open source, gratis y sin API key
# =====================================================================
# Por defecto usa el contenedor `ollama` de docker-compose.
# Tras el primer `docker compose up -d`, descarga el modelo una sola vez:
#   docker compose exec ollama ollama pull llama3.2:3b
AI_ENABLED=true
AI_BASE_URL=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=llama3.2:3b

# Clasificador semántico anti inyección de prompts (capa 1b).
# Modelo multilingüe open source (278 MB), ~400 ms por consulta, sin coste.
# Se eligió multilingüe porque all-minilm es solo inglés y separaba mal en español:
#   docker compose exec ollama ollama pull paraphrase-multilingual
AI_EMBEDDING_MODEL=paraphrase-multilingual

# Modelos probados en este proyecto (ambos responden correctamente):
#   llama3.2:3b  -> ~2 GB RAM. Por defecto: corre en cualquier servidor modesto.
#   qwen2.5:7b   -> ~5 GB RAM. Mejor español y más rápido una vez cargado en memoria.
#                   Recomendado si el servidor tiene 8 GB+ libres:
#                   docker compose exec ollama ollama pull qwen2.5:7b

# Alternativas gratuitas en la nube (si el servidor no aguanta el modelo local).
# Solo cambia estas tres variables, el código es el mismo:
#   Groq       -> AI_BASE_URL=https://api.groq.com/openai/v1
#                 AI_MODEL=llama-3.3-70b-versatile        + AI_API_KEY=gsk_...
#   OpenRouter -> AI_BASE_URL=https://openrouter.ai/api/v1
#                 AI_MODEL=meta-llama/llama-3.3-70b-instruct:free + AI_API_KEY=sk-or-...
#
# Si despliegas la API en un PaaS sin Ollama (Render, Railway…), usa una de las
# alternativas de arriba o pon AI_ENABLED=false: la web ocultará el chat y el
# recomendador en vez de mostrarlos rotos.
